# Application
APP_NAME=EZFINANZ
APP_ENV=development
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ezfinanz

# Authentication
JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth 2.0 (Google Identity Services)
GOOGLE_CLIENT_ID=

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage
STORAGE_DIR=./storage
