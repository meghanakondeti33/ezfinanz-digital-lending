# Application
APP_NAME=EZFINANZ
APP_ENV=development
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ezfinanz

# Authentication
JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth 2.0 (Google Identity Services)
GOOGLE_CLIENT_ID=

# SMS OTP Configuration
# OTP_MODE: 'demo' (returns dev OTP in API response) or 'sms' (sends real SMS via provider)
OTP_MODE=demo
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# SMS Provider Options: 'fast2sms', '2factor', 'msg91', 'twilio', 'mock'
SMS_PROVIDER=fast2sms
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=

# Twilio Specific Settings (if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage
STORAGE_DIR=./storage
